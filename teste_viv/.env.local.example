# ============================================
# CONFIGURAÇÃO MINIO - DESENVOLVIMENTO LOCAL
# ============================================

# URL do servidor MinIO
# Exemplo: http://localhost:9000 (local)
# Exemplo: https://minio.seudominio.com (produção)
MINIO_ENDPOINT=http://localhost:9000

# Chave de acesso do MinIO
# Padrão em desenvolvimento: minioadmin
MINIO_ACCESS_KEY=minioadmin

# Chave secreta do MinIO
# Padrão em desenvolvimento: minioadmin
MINIO_SECRET_KEY=minioadmin

# Nome do bucket para armazenar documentos
# Será criado automaticamente se não existir
MINIO_BUCKET_NAME=condominio-docs

# ============================================
# VARIÁVEIS PÚBLICAS (cliente-side)
# ============================================

# Endpoint público do MinIO (pode ser diferente da URL interna)
# Usado pelo cliente para baixar arquivos
NEXT_PUBLIC_MINIO_ENDPOINT=http://localhost:9000

# Nome do bucket (informação pública)
NEXT_PUBLIC_MINIO_BUCKET_NAME=condominio-docs
