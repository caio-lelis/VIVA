# MinIO Configuration
# Substitua os valores abaixo com as credenciais do seu servidor MinIO

# URL do servidor MinIO (ex: http://localhost:9000 ou https://minio.seudominio.com)
MINIO_ENDPOINT=http://localhost:9000

# Chave de acesso do MinIO (padrão: minioadmin)
MINIO_ACCESS_KEY=minioadmin

# Chave secreta do MinIO (padrão: minioadmin)
MINIO_SECRET_KEY=minioadmin

# Nome do bucket para armazenar os documentos do condomínio
MINIO_BUCKET_NAME=condominio-docs
